{
  "name": "multiverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p tests",
    "test": "node --import tsx tests/guest-db.test.ts && node --import tsx tests/guest-server.test.ts && node --import tsx tests/ping-server.test.ts",
    "server": "tsx server/main.ts",
    "online": "vite build && tsx server/main.ts --public",
    "tunnel": "tsx server/tunnel-main.ts",
    "firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/allow-firewall.ps1"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
